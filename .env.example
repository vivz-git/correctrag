# CorrectRAG — Environment Configuration Example
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# Usage:
#   cp .env.example .env
#   # Edit .env and set GEMINI_API_KEY
#   python scripts/demo_rag.py CRAG.pdf

# ─────────────────────────────────────────────────────────────────────────────
# LLM Provider Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Active LLM provider: "groq" (default) or "gemini"
LLM_PROVIDER=groq

# ─────────────────────────────────────────────────────────────────────────────
# Groq API (Primary Production & Demo Provider)
# ─────────────────────────────────────────────────────────────────────────────

# Required when LLM_PROVIDER=groq — obtain from https://console.groq.com/keys
GROQ_API_KEY=

# Optional — override the default model (openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# ─────────────────────────────────────────────────────────────────────────────
# Google Gemini API (Alternate Provider)
# ─────────────────────────────────────────────────────────────────────────────

# Required when LLM_PROVIDER=gemini — obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional — override the default model (gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash

# ─────────────────────────────────────────────────────────────────────────────
# Tavily Search API
# ─────────────────────────────────────────────────────────────────────────────

# Required for CRAG web search — obtain from https://tavily.com
TAVILY_API_KEY=

# Optional — maximum search results to retrieve (default: 5)
TAVILY_MAX_RESULTS=5

